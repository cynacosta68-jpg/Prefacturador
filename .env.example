# En Easypanel se cargan en "Environment".
ADMIN_USER=admin
ADMIN_PASSWORD=            # obligatoria, mínimo 10 caracteres. Solo se usa en el PRIMER arranque para crear el administrador
COOKIE_SECURE=true         # false solo para probar sin HTTPS
SESSION_HOURS=12           # duración máxima de una sesión
IDLE_MINUTES=60            # cierre por inactividad
BACKUP_HOURS=24            # copia de seguridad automática cada N horas
BACKUP_KEEP=30             # cuántas copias se conservan
DATA_DIR=/data
HEADLESS=true
TZ=America/Argentina/Buenos_Aires
MAX_UPLOAD_MB=40
EVWEB_URL=https://cmsc.evweb.com.ar/Account/Login
LINK_GALENO=https://www.galeno.com.ar/
LINK_AVALIAN=https://online.avalian.com/prestador/ingreso
LINK_SANCOR=https://autogestionprestadores.sancorsalud.com.ar/#/login
